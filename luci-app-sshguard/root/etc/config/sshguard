
config sshguard 'main'
	option enabled '0'
	option bark_url 'https://api.day.app/你的BarkKey'
	option auto_direct '1'
	option direct_addr ''
	option group 'router'
	option level 'timeSensitive'
	option sound ''
	option threshold '5'
	option window '10'
	option cooldown '60'
	option lan_prefix '192.168.2.'
	option notify_fail '1'
	option notify_success '1'
	option notify_web_success '1'
	option notify_lan_login '1'
	option geo '1'
	option ban_enabled '1'
	option ban_time '1440'
	option report_enabled '1'
	option report_hour '9'
	option report_minute '0'
	option report_top '1'
	option report_login '1'
	option report_ban '1'
	option report_sys '1'
	option fail_title '⚠️ {host} SSH 暴力破解'
	option fail_body '{ip}（{loc}）在 {minutes} 分钟内失败 {count} 次，最近尝试用户：{user}。{ban}'
	option ok_title '🔐 {host} SSH 登录成功'
	option ok_body '用户 {user} 从 {ip}（{loc}）登录，时间 {time}'
	option web_title '🌐 {host} 网页后台登录成功'
	option web_body '用户 {user} 从 {ip}（{loc}）登录 LuCI，时间 {time}'
