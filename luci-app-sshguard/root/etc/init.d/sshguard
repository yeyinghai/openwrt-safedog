#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
	if [ "$(uci -q get sshguard.main.enabled)" != 1 ]; then
		/usr/bin/sshguard.sh cron off
		return 0
	fi
	/usr/bin/sshguard.sh cron on
	procd_open_instance
	procd_set_param command /usr/bin/sshguard.sh
	procd_set_param respawn
	procd_close_instance
}

stop_service() {
	/usr/bin/sshguard.sh cleanup
}

service_triggers() {
	procd_add_reload_trigger "sshguard"
}
